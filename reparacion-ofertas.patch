+            registro.update(estado="error", error=f"{type(exc).__name__}: {exc}"[:300])
+            logger.error("[%s] fallo aislado: %s", fuente.nombre, registro["error"])
+    registro["segundos"] = round(time.monotonic() - inicio, 1)
+    salida[fuente.nombre] = registro
