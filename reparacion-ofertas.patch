+        return entrada
+    nueva = dict(entrada or {})
+    nueva.update({
+        "tienda": item.get("tienda"), "titulo": item.get("titulo"), "url": item.get("url"),
+        "precio_actual": actual, "precio_maximo": maximo, "ultima_actualizacion": ahora,
+    })
