 STORES_FALLBACK = {
     "WALMART_STORE_ID": "0000003362",
-    "BODEGA_STORE_ID": "0000003001"
+    "BODEGA_STORE_ID": "0000003001",
 }
+
+
+def get_endpoint(name: str) -> str:
+    """Endpoint configurado o "" si no existe (nunca lanza excepción)."""
